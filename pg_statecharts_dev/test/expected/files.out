-- A chart with no transitions still produces a migration that runs, rather
-- than a NULL body that silently writes nothing.
select fsm.__migration_deploy(
  '<scxml xmlns="http://www.w3.org/2005/07/scxml" name="lonely" version="1.0" initial="s">'
  '<state id="s" name="S"/></scxml>'::xml, 'proj', 'lonely', '1.0');
                                             __migration_deploy                                              
-------------------------------------------------------------------------------------------------------------
 -- Deploy proj:statechart/lonely-1.0 to pg                                                                 +
                                                                                                            +
 -- FILE AUTOMATICALLY GENERATED. MANUAL CHANGES MIGHT BE OVERWRITTEN                                       +
                                                                                                            +
 BEGIN;                                                                                                     +
 do $$                                                                                                      +
 declare                                                                                                    +
 chart bigint;                                                                                              +
 begin                                                                                                      +
 insert into fsm.statechart (name, version) values ('lonely', fsm.to_semver('1.0')) returning id into chart;+
 insert into fsm.state (statechart_id, id, name, parent_id, is_initial, is_final, on_entry, on_exit) values +
 (chart, 's', 'S', null, true, false, array[]::fsm_callback_name[], array[]::fsm_callback_name[]);          +
 end                                                                                                        +
 $$;                                                                                                        +
 COMMIT;                                                                                                    +
 
(1 row)

-- and a null body is refused loudly rather than silently skipped
select fsm.__write_file('/tmp/pg_statecharts_test_null.txt', null);
ERROR:  refusing to write /tmp/pg_statecharts_test_null.txt because the content is null
drop function cb_one(fsm_event_payload);
